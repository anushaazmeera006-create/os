diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index cd25557..1d0f8f3 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,30 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+uint64
+sys_shm_get(void)
+{
+  struct proc *p = myproc();
+
+  if (p->shm != 0)
+    return p->shm;
+
+  char *mem = kalloc();
+  if (mem == 0)
+    return 0;
+
+  memset(mem, 0, PGSIZE);
+
+  uint64 pa = (uint64)mem;
+
+  if (mappages(p->pagetable, SHMBASE, PGSIZE, pa,
+               PTE_R | PTE_W | PTE_U) != 0) {
+    kfree(mem);
+    return 0;
+  }
+
+  p->shm = SHMBASE;
+  p->shm_pa = pa;
+
+  return p->shm;
+}
