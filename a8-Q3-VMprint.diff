+// Q3: Walk a page table, printing user entries and counting kernel mappings.
+static void
+vmprint_walk(pagetable_t pagetable, int level, uint64 prefix,
+             int depth, uint *kernel_entries)
+{
+  for (int i = 0; i < 512; i++) {
+    pte_t pte = pagetable[i];
+
+    if ((pte & PTE_V) == 0)
+      continue;
+
+    uint64 va = prefix | ((uint64)i << (12 + 9 * level));
+    int leaf = (pte & (PTE_R | PTE_W | PTE_X)) != 0;
+
+    if (va >= KERNBASE) {
+      if (leaf)
+        (*kernel_entries)++;
+      else if (level > 0)
+        vmprint_walk((pagetable_t)PTE2PA(pte), level - 1, va,
+                     depth + 1, kernel_entries);
+      continue;
+    }
+
+    for (int j = 0; j < depth; j++)
+      printk("  ");
+
+    if (!leaf && level > 0) {
+      printk("L%d[%d] table_pa=%p P=%d W=%d U=%d\n",
+             level, i, (void*)PTE2PA(pte),
+             (pte & PTE_V) != 0, (pte & PTE_W) != 0,
+             (pte & PTE_U) != 0);
+      vmprint_walk((pagetable_t)PTE2PA(pte), level - 1, va,
+                   depth + 1, kernel_entries);
+    } else {
+      printk("L0[%d] va=%p pa=%p P=%d W=%d U=%d\n",
+             i, (void*)va, (void*)PTE2PA(pte),
+             (pte & PTE_V) != 0, (pte & PTE_W) != 0,
+             (pte & PTE_U) != 0);
+    }
+  }
+}
+
+// Q3: Print the calling process page table and kernel-entry count.
+void
+vmprint(pagetable_t pagetable)
+{
+  uint kernel_entries = 0;
+
+  printk("page table dump:\n");
+  vmprint_walk(pagetable, 2, 0, 0, &kernel_entries);
+  printk("kernel entries: %d\n", (int)kernel_entries);
+}
