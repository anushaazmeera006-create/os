+// ===== Lab 4 Q1: SRTF preemption helper =====
+// Returns 1 if a RUNNABLE process has less remaining time
+// than the currently running process.
+int
+srtf_should_preempt(struct proc *current)
+{
+  struct proc *p;
+
+  if(current == 0)
+    return 0;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    if(p == current)
+      continue;
+
+    acquire(&p->lock);
+
+    if(p->state == RUNNABLE &&
+       p->remaining_time > 0 &&
+       p->remaining_time < current->remaining_time){
+      release(&p->lock);
+      return 1;
+    }
+
+    release(&p->lock);
+  }
+
+  return 0;
+}
