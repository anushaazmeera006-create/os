+// ===== Lab 4 Q1: SRTF Scheduler =====
+// Set burst time for a process identified by PID.
+int
+set_burst_for_pid(int pid, int bt)
+{
+  struct proc *p;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+
+    if(p->pid == pid){
+      p->burst_time = bt;
+      p->remaining_time = bt;
+      release(&p->lock);
+      return 0;
+    }
+
+    release(&p->lock);
+  }
+
+  return -1;
+}
