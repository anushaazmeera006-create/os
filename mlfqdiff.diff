-  // ask for the next timer interrupt. this also clears
-  // the interrupt request. 1000000 is about a tenth
-  // of a second.
+  if (p != 0) {
+    acquire(&p->lock);
+
+    if (p->state == RUNNING) {
+      // Quantum = 2^queue_level:
+      // level 0 -> 1 tick
+      // level 1 -> 2 ticks
+      // level 2 -> 4 ticks
+      quantum = 1 << p->queue_level;
+
+      p->ticks_used++;
+
+      // Process used its complete time slice.
+      if (p->ticks_used >= quantum) {
+        p->ticks_used = 0;
+
+        // Demote CPU-bound processes.
+        if (p->queue_level < 2)
+          p->queue_level++;
+
+        should_yield = 1;
+      }
