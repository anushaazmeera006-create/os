+// Queue 0 gets 1 tick, queue 1 gets 2 ticks,
+// and queue 2 gets 4 ticks.
 void
 clockintr()
 {
+  struct proc *p = myproc();
+  int quantum;
+  int should_yield = 0;
+
   if (cpuid() == 0) {
     acquire(&tickslock);
