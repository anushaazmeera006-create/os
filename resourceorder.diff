--- xv6-clean/proc.c	2026-08-24 14:26:16.677276700 +0000
+++ asg6/q3-resourceorder/proc.c	2026-09-13 15:36:04.545258000 +0000
@@ -532,3 +532,76 @@
     cprintf("\n");
   }
 }
+
+char *shm_page = 0;   // Lab 6 Q1: the shared physical page
+
+int
+shm_get(void)
+{
+  struct proc *cur = myproc();
+  char *page;
+
+  acquire(&ptable.lock);
+  if(shm_page == 0){
+    shm_page = kalloc();
+    if(shm_page)
+      memset(shm_page, 0, PGSIZE);
+  }
+  page = shm_page;
+  release(&ptable.lock);
+
+  if(page == 0)
+    return -1;
+  if(shm_map(cur->pgdir, (void*)SHM_VA, V2P(page)) < 0)
+    return -1;
+  return SHM_VA;
+}
+
+// Lab 6 Q2: Kernel Semaphores for Producer-Consumer
+struct ksem {
+  struct spinlock lock;
+  int count;
+};
+struct ksem ksems[8];   // Lab 6 Q4: pool of 8 (0-4 = forks) // 0=empty, 1=full, 2=mutex
+static int ksems_initialized = 0;
+
+void init_ksems(void) {
+  int i;
+  if(!ksems_initialized) {
+    for(i = 0; i < 8; i++)
+      initlock(&ksems[i].lock, "ksem");
+    ksems_initialized = 1;
+  }
+}
+
+int sem_init(int which, int count) {
+  init_ksems();
+  if(which < 0 || which > 7) return -1;
+  acquire(&ksems[which].lock);
+  ksems[which].count = count;
+  release(&ksems[which].lock);
+  return 0;
+}
+
+int sem_wait(int which) {
+  init_ksems();
+  if(which < 0 || which > 7) return -1;
+  acquire(&ksems[which].lock);
+  while(ksems[which].count <= 0) {
+    sleep(&ksems[which], &ksems[which].lock); // sleep releases the lock, reacquires on wakeup
+  }
+  ksems[which].count--;
+  release(&ksems[which].lock);
+  return 0;
+}
+
+int sem_signal(int which) {
+  init_ksems();
+  if(which < 0 || which > 7) return -1;
+  acquire(&ksems[which].lock);
+  ksems[which].count++;
+  wakeup(&ksems[which]); // wake up any process sleeping on this semaphore
+  release(&ksems[which].lock);
+  return 0;
+}
+
--- /dev/null	2026-09-13 15:14:53.606301197 +0000
+++ asg6/q3-resourceorder/resourceorder.c	2026-09-13 15:36:09.785274100 +0000
@@ -0,0 +1,90 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+/* fixed mode uses semaphores 0,1 ; bad mode uses 2,3 (isolates stuck procs) */
+static void
+delay(int n)
+{
+  volatile int i;
+  for(i = 0; i < n; i++)
+    ;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int pidA, pidB, fixed, l1, l2;
+
+  fixed = (argc > 1 && argv[1][0] == 'f');
+  l1 = fixed ? 0 : 2;
+  l2 = fixed ? 1 : 3;
+
+  sem_init(0, 1); sem_init(1, 1);
+  sem_init(2, 1); sem_init(3, 1);
+
+  printf(1, "=== Resource-ordering demo: %s ===\n",
+         fixed ? "FIXED (both processes take Lock1 then Lock2)"
+               : "BAD (A: Lock1->Lock2, B: Lock2->Lock1)");
+
+  pidA = fork();
+  if(pidA == 0){
+    /* Process A: always Lock1 then Lock2 */
+    printf(1, "[tick %d] Process A waiting for Lock1\n", uptime());
+    sem_wait(l1);
+    printf(1, "[tick %d] Process A acquired Lock1\n", uptime());
+    delay(4000000);              /* deliberate window to force the clash */
+    printf(1, "[tick %d] Process A waiting for Lock2\n", uptime());
+    sem_wait(l2);
+    printf(1, "[tick %d] Process A acquired Lock2 - in critical section\n", uptime());
+    sleep(3);
+    sem_signal(l2);
+    sem_signal(l1);
+    printf(1, "[tick %d] Process A released both locks - COMPLETED\n", uptime());
+    exit();
+  }
+
+  pidB = fork();
+  if(pidB == 0){
+    if(fixed){
+      /* FIXED: same global order as A */
+      printf(1, "[tick %d] Process B waiting for Lock1\n", uptime());
+      sem_wait(l1);
+      printf(1, "[tick %d] Process B acquired Lock1\n", uptime());
+      delay(4000000);
+      printf(1, "[tick %d] Process B waiting for Lock2\n", uptime());
+      sem_wait(l2);
+      printf(1, "[tick %d] Process B acquired Lock2 - in critical section\n", uptime());
+      sleep(3);
+      sem_signal(l2);
+      sem_signal(l1);
+      printf(1, "[tick %d] Process B released both locks - COMPLETED\n", uptime());
+    } else {
+      /* BAD: opposite order -> circular wait */
+      printf(1, "[tick %d] Process B waiting for Lock2\n", uptime());
+      sem_wait(l2);
+      printf(1, "[tick %d] Process B acquired Lock2\n", uptime());
+      delay(4000000);
+      printf(1, "[tick %d] Process B waiting for Lock1\n", uptime());
+      sem_wait(l1);   /* blocks forever: A holds Lock1, waits for Lock2 */
+      printf(1, "[tick %d] Process B acquired Lock1 - in critical section\n", uptime());
+      sleep(3);
+      sem_signal(l1);
+      sem_signal(l2);
+      printf(1, "[tick %d] Process B released both locks - COMPLETED\n", uptime());
+    }
+    exit();
+  }
+
+  if(fixed){
+    wait();
+    wait();
+    printf(1, "[tick %d] Parent: both processes COMPLETED - no hang with consistent ordering\n", uptime());
+  } else {
+    sleep(50);   /* watchdog / timeout window */
+    printf(1, "[tick %d] Parent WATCHDOG: 50 ticks elapsed, zero COMPLETED lines:\n", uptime());
+    printf(1, "  A holds Lock1 and waits for Lock2; B holds Lock2 and waits for Lock1.\n");
+    printf(1, "  DEADLOCK (circular wait) confirmed - without intervention this run hangs forever.\n");
+  }
+  exit();
+}
