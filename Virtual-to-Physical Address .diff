--- /dev/null	2026-11-03 09:58:59.254016748 +0000
+++ asg10/q2-vtop/vttest.c	2026-11-03 10:47:15.137931800 +0000
@@ -0,0 +1,86 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int
+main(void)
+{
+  char *p;
+  int va1, va2, va3, va_invalid;
+  int pa1, pa2, pa3, pa_invalid;
+
+  printf(1, "=== Virtual to Physical Address Translation Test ===\n\n");
+
+  // Allocate some memory
+  printf(1, "Allocating 4 pages via sbrk...\n");
+  p = sbrk(4 * 4096);
+  if(p == (char*)-1){
+    printf(1, "sbrk failed\n");
+    exit();
+  }
+  
+  // Touch the pages to ensure they're allocated
+  p[0] = 'A';
+  p[4096] = 'B';
+  p[8192] = 'C';
+  p[12288] = 'D';
+  
+  printf(1, "Memory allocated at virtual address: %x\n\n", (uint)p);
+
+  // Test 1: First page
+  va1 = (int)p;
+  pa1 = vtop(va1);
+  printf(1, "Test 1 - First page:\n");
+  printf(1, "  Virtual Address:  %x\n", va1);
+  if(pa1 == -1)
+    printf(1, "  Physical Address: unmapped/invalid\n");
+  else
+    printf(1, "  Physical Address: %x\n", pa1);
+  printf(1, "\n");
+
+  // Test 2: Second page
+  va2 = (int)(p + 4096);
+  pa2 = vtop(va2);
+  printf(1, "Test 2 - Second page:\n");
+  printf(1, "  Virtual Address:  %x\n", va2);
+  if(pa2 == -1)
+    printf(1, "  Physical Address: unmapped/invalid\n");
+  else
+    printf(1, "  Physical Address: %x\n", pa2);
+  printf(1, "\n");
+
+  // Test 3: Third page
+  va3 = (int)(p + 8192);
+  pa3 = vtop(va3);
+  printf(1, "Test 3 - Third page:\n");
+  printf(1, "  Virtual Address:  %x\n", va3);
+  if(pa3 == -1)
+    printf(1, "  Physical Address: unmapped/invalid\n");
+  else
+    printf(1, "  Physical Address: %x\n", pa3);
+  printf(1, "\n");
+
+  // Test 4: Invalid address (way beyond allocated space)
+  va_invalid = (int)0xFFFFFFFF;
+  pa_invalid = vtop(va_invalid);
+  printf(1, "Test 4 - Invalid address (0xFFFFFFFF):\n");
+  printf(1, "  Virtual Address:  %x\n", va_invalid);
+  if(pa_invalid == -1)
+    printf(1, "  Physical Address: unmapped/invalid (as expected)\n");
+  else
+    printf(1, "  Physical Address: %x\n", pa_invalid);
+  printf(1, "\n");
+
+  // Test 5: NULL address
+  printf(1, "Test 5 - NULL address (0x0):\n");
+  printf(1, "  Virtual Address:  0\n");
+  pa_invalid = vtop(0);
+  if(pa_invalid == -1)
+    printf(1, "  Physical Address: unmapped/invalid (as expected)\n");
+  else
+    printf(1, "  Physical Address: %x\n", pa_invalid);
+  printf(1, "\n");
+
+  printf(1, "=== vttest done ===\n");
+  exit();
+}
--- xv6-clean/vm.c	2026-08-24 14:26:16.976258900 +0000
+++ asg10/q2-vtop/vm.c	2026-11-03 10:46:56.982646000 +0000
@@ -392,3 +392,27 @@
 //PAGEBREAK!
 // Blank page.
 
+
+// Asg10 Q2: Translate virtual address to physical address
+int
+vtop(uint va)
+{
+  pte_t *pte;
+  uint pa;
+  struct proc *cur = myproc();
+  
+  if(cur == 0)
+    return -1;
+  
+  // Walk the page table to find the PTE
+  pte = walkpgdir(cur->pgdir, (void*)va, 0);
+  
+  // If PTE doesn't exist or is not present, return -1
+  if(pte == 0 || (*pte & PTE_P) == 0)
+    return -1;
+  
+  // Extract physical frame address from PTE and add offset
+  pa = PTE_ADDR(*pte) | (va & 0xFFF);
+  
+  return pa;
+}
