+uint64
+sys_va2pa(void)
+{
+  uint64 va;
+  argaddr(0, &va);
+
+  struct proc *p = myproc();
+  pte_t *pte = walk(p->pagetable, va, 0);
+
+  if (pte == 0 || (*pte & PTE_V) == 0 || (*pte & PTE_U) == 0) {
+    printk("va2pa: va=%p is unmapped or not user accessible\n", (void*)va);
+    return (uint64)-1;
+  }
+
+  uint64 pa = PTE2PA(*pte) | (va & (PGSIZE - 1));
+  int present = (*pte & PTE_V) != 0;
+  int writable = (*pte & PTE_W) != 0;
+  int user = (*pte & PTE_U) != 0;
+
+  printk("va2pa: va=%p pa=%p L2=%d L1=%d L0=%d offset=%d P=%d W=%d U=%d\n",
+          (void*)va, (void*)pa,
+         (int)((va >> 30) & 0x1ff),
+         (int)((va >> 21) & 0x1ff),
+         (int)((va >> 12) & 0x1ff),
+         (int)(va & (PGSIZE - 1)),
+         present, writable, user);
+
+  return pa;
+}
