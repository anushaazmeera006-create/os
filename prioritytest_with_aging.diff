+// Asg3 Q2: kernel helper to set a process's priority
+int
+set_proc_priority(int pid, int pr)
+{
+  struct proc *p;
+  int found = 0;
+  if(pr < 1 || pr > 20)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid && (p->state == RUNNING || p->state == RUNNABLE)){
+      p->priority = pr;
+      p->wait_ticks = 0;
+      found = 1;
+      break;
+    }
+  }
+  release(&ptable.lock);
+  return found ? 0 : -1;
+}
--- /dev/null	2026-11-14 05:22:55.860081675 +0000
+++ asg3_q2/priotest.c	2026-11-14 08:31:37.485786600 +0000
@@ -0,0 +1,35 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+void
+work(int id, int pr, int loops)
+{
+  volatile int x = 0;
+  int i;
+  set_priority(getpid(), pr);
+  printf(1, "P%d (pid %d, prio %d) start\n", id, getpid(), pr);
+  for(i = 0; i < loops; i++) x++;
+  printf(1, "P%d (pid %d, prio %d) done\n", id, getpid(), pr);
+}
+
+int
+main(void)
+{
+  int i;
+  printf(1, "=== Priority + Aging Scheduler Test ===\n");
+  printf(1, "Forking 4 procs with priorities 1,5,10,20\n\n");
+
+  if(fork() == 0){ work(1, 1, 30000000); exit(); }
+  for(i=0;i<2000000;i++);
+  if(fork() == 0){ work(2, 5, 30000000); exit(); }
+  for(i=0;i<2000000;i++);
+  if(fork() == 0){ work(3, 10, 30000000); exit(); }
+  for(i=0;i<2000000;i++);
+  if(fork() == 0){ work(4, 20, 30000000); exit(); }
+
+  wait(); wait(); wait(); wait();
+  printf(1, "\n=== Expected 'done' order: P1,P2,P3,P4 (priority order) ===\n");
+  printf(1, "=== priotest done ===\n");
+  exit();
+}
