+
+  argint(0, &sem_id);
+  return ksem_wait(sem_id);
+}
+
+// Q2: release one semaphore permit.
+uint64
+sys_sem_signal(void)
+{
+  int sem_id;
+
+  argint(0, &sem_id);
+  return ksem_signal(sem_id);
+}
