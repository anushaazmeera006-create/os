+// ===== Lab 4 Q2: HRRN Scheduler =====
+uint64
+sys_set_burst(void)
+{
+  int bt;
+  struct proc *p = myproc();
+
+  argint(0, &bt);
+
+  if(bt <= 0)
+    return -1;
+
+  acquire(&p->lock);
+  p->burst_time = bt;
+  release(&p->lock);
+
+  return 0;
+}
