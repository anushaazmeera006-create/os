+// Q2: Copy memory statistics for the calling process to user space.
+uint64
+sys_getmeminfo(void)
+{
+  uint64 addr;
+  struct proc *p = myproc();
+  struct meminfo info;
+
+  argaddr(0, &addr);
+
+  info.total_pages = (PHYSTOP - KERNBASE) / PGSIZE;
+  info.free_pages = freemem_count();
+  info.user_pages = p->sz / PGSIZE;
+  info.page_table_pages = pagetable_page_count(p->pagetable);
+
+    // Q2: Copy statistics to a destination within the process address space.
+  if (copyout(p->pagetable, p->sz, addr, (char *)&info, sizeof(info)) < 0)
+    return (uint64)-1;
+
+  return 0;
+}
