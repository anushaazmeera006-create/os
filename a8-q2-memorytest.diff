+// Q2: Count this page table and its valid child page tables.
+static uint
+countpagetable(pagetable_t pagetable, int level)
+{
+  uint count = 1;
+
+  if (level == 0)
+    return count;
+
+  for (int i = 0; i < 512; i++) {
+    pte_t pte = pagetable[i];
+
+    if ((pte & PTE_V) && (pte & (PTE_R | PTE_W | PTE_X)) == 0)
+      count += countpagetable((pagetable_t)PTE2PA(pte), level - 1);
+  }
+
+  return count;
+}
+
+// Q2: Return the number of page-table pages used by a process.
+uint
+pagetable_page_count(pagetable_t pagetable)
+{
+  return countpagetable(pagetable, 2);
+}
