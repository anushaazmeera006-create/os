+// Q1: read the user arguments and create a thread in the caller's address space.
+uint64
+sys_clone(void)
+{
+  uint64 fcn;
+  uint64 arg;
+  uint64 stack;
+
+  argaddr(0, &fcn);
+  argaddr(1, &arg);
+  argaddr(2, &stack);
+  return kclone(fcn, arg, stack);
+}
+
+// Q1: wait for one child thread to exit and reclaim its kernel resources.
+uint64
+sys_join(void)
+{
+  return kjoin();
+}
