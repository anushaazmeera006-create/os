+// Q1: create a runnable thread that shares the leader's physical user pages.
+int
+kclone(uint64 fcn, uint64 arg, uint64 stack)
+{
+  int i;
+  int pid;
+  struct proc *np;
+  struct proc *p = myproc();
+  struct proc *leader = p->is_thread ? p->thread_leader : p;
+
+  // The test program supplies one page-aligned, one-page user stack.
+  if (fcn >= leader->sz || stack == 0 || (stack % PGSIZE) != 0 ||
+      stack + PGSIZE < stack || stack + PGSIZE > leader->sz ||
+      walkaddr(leader->pagetable, stack) == 0)
+    return -1;
+
+  if ((np = allocproc()) == 0)
+    return -1;
+
+  // A thread has a separate trapframe/page-table root on RISC-V, but every
+  // user virtual page maps to the same physical page as the group leader.
+  np->is_thread = 1;
+  np->thread_leader = leader;
+  np->sz = leader->sz;
+
+  if (share_user_memory(leader->pagetable, np->pagetable, np->sz) < 0) {
+    freeproc(np);
+    release(&np->lock);
+    return -1;
+  }
+
+  // Start at fcn(arg), using the caller-supplied stack page.
+  *(np->trapframe) = *(p->trapframe);
+  np->trapframe->epc = fcn;
+  np->trapframe->sp = (stack + PGSIZE) & ~0xFUL;
+  np->trapframe->a0 = arg;
+
+  // Give the thread usable copies of the caller's open files and directory.
+  for (i = 0; i < NOFILE; i++)
+    if (p->ofile[i])
+      np->ofile[i] = filedup(p->ofile[i]);
+  np->cwd = idup(p->cwd);
+  safestrcpy(np->name, p->name, sizeof(np->name));
+
+  pid = np->pid;
+  release(&np->lock);
+
+  // All threads belong to the leader, so the leader can join every thread.
+  acquire(&wait_lock);
+  np->parent = leader;
+  release(&wait_lock);
+
+  acquire(&np->lock);
+  np->state = RUNNABLE;
+  release(&np->lock);
+
+  return pid;
+}
