+// Q1: wait for one child thread of the group leader to finish.
+int
+kjoin(void)
+{
+  struct proc *pp;
+  struct proc *p = myproc();
+  int have_threads;
+  int pid;
+
+  // clone() assigns every thread to its group leader.
+  if (p->is_thread)
+    return -1;
+
+  acquire(&wait_lock);
+  for (;;) {
+    have_threads = 0;
+
+    for (pp = proc; pp < &proc[NPROC]; pp++) {
+      if (pp->parent == p && pp->is_thread) {
+        acquire(&pp->lock);
+        have_threads = 1;
+
+        if (pp->state == ZOMBIE) {
+          pid = pp->pid;
+          pp->parent = 0;
+          freeproc(pp);
+          release(&pp->lock);
+          release(&wait_lock);
+          return pid;
+        }
+        release(&pp->lock);
+      }
+    }
+
+    if (!have_threads || killed(p)) {
+      release(&wait_lock);
+      return -1;
+    }
+
+    sleep_prepare(p);
+    release(&wait_lock);
+    sleep();
+    acquire(&wait_lock);
+  }
+}
