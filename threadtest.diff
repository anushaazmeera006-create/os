+// Q1: remove a thread's mappings without freeing the physical user pages.
+// Those pages belong to the thread-group leader and may still be used by
+// other threads.
+static void
+thread_freepagetable(pagetable_t pagetable, uint64 sz)
+{
+  uint64 va;
+
+  for (va = 0; va < sz; va += PGSIZE) {
+    pte_t *pte = walk(pagetable, va, 0);
+    if (pte != 0 && (*pte & PTE_V))
+      uvmunmap(pagetable, va, 1, 0);
+  }
+
+  uvmunmap(pagetable, TRAMPOLINE, 1, 0);
+  uvmunmap(pagetable, TRAPFRAME, 1, 0);
+  uvmfree(pagetable, 0);
+}
+
+// Q1: map every existing user page from src into dst at the same virtual
+// address. The physical pages are shared; only the page-table pages differ.
+static int
+share_user_memory(pagetable_t src, pagetable_t dst, uint64 sz)
+{
+  uint64 va;
+
+  for (va = 0; va < sz; va += PGSIZE) {
+    pte_t *pte = walk(src, va, 0);
+    if (pte == 0 || (*pte & PTE_V) == 0)
+      continue;
+
+    if (mappages(dst, va, PGSIZE, PTE2PA(*pte), PTE_FLAGS(*pte)) != 0)
+      return -1;
+  }
+  return 0;
+}
