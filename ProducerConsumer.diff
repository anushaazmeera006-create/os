+uint64
+sys_shm_get(void)
+{
+  struct proc *p = myproc();
+
+  if (p->shm != 0)
+    return p->shm;
+
+  char *mem = kalloc();
+  if (mem == 0)
+    return 0;
+
+  memset(mem, 0, PGSIZE);
+
+  uint64 pa = (uint64)mem;
+
+  if (mappages(p->pagetable, SHMBASE, PGSIZE, pa,
+               PTE_R | PTE_W | PTE_U) != 0) {
+    kfree(mem);
+    return 0;
+  }
+
+  p->shm = SHMBASE;
+  p->shm_pa = pa;
+
+  return p->shm;
+}
+uint64
+sys_sem_init(void)
+{
+  int value;
+
+  argint(0, &value);
+
+  return sem_create(value);
+}
+
+uint64
+sys_sem_wait(void)
+{
+  int id;
+
+  argint(0, &id);
+
+  return sem_wait(id);
+}
+
+uint64
+sys_sem_signal(void)
+{
+  int id;
+
+  argint(0, &id);
+
+  return sem_signal(id);
+}
