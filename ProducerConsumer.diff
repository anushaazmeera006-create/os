+struct {
+  struct spinlock lock;
+  struct semaphore sem[NSEM];
+} semtable;
+
+void
+seminit(void)
+{
+  initlock(&semtable.lock, "semtable");
+
+  for (int i = 0; i < NSEM; i++) {
+    semtable.sem[i].used = 0;
+    semtable.sem[i].value = 0;
+  }
+}
+
+int
+sem_create(int value)
+{
+  if (value < 0)
+    return -1;
+
+  acquire(&semtable.lock);
+
+  for (int i = 0; i < NSEM; i++) {
+    if (!semtable.sem[i].used) {
+      semtable.sem[i].used = 1;
+      semtable.sem[i].value = value;
+      release(&semtable.lock);
+      return i;
+    }
+  }
+
+  release(&semtable.lock);
+  return -1;
+}
+
+int
+sem_wait(int id)
+{
+  if (id < 0 || id >= NSEM)
+    return -1;
+
+  acquire(&semtable.lock);
+
+  if (!semtable.sem[id].used) {
+    release(&semtable.lock);
+    return -1;
+  }
+
+  while (semtable.sem[id].value == 0) {
+   release(&semtable.lock);
+   sleep();
+   acquire(&semtable.lock);
+  }
+
+  semtable.sem[id].value--;
+
+  release(&semtable.lock);
+  return 0;
+}
+
+int
+sem_signal(int id)
+{
+  if (id < 0 || id >= NSEM)
+    return -1;
+
+  acquire(&semtable.lock);
+
+  if (!semtable.sem[id].used) {
+    release(&semtable.lock);
+    return -1;
+  }
+
+  semtable.sem[id].value++;
+  wakeup(&semtable.sem[id]);
+
+  release(&semtable.lock);
+  return 0;
+}
